# -----------------------------------------------------------------------------
# PostgreSQL (docker-compose postgres service)
# -----------------------------------------------------------------------------
POSTGRES_DB=airagservice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# API (docker-compose api service)
# -----------------------------------------------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# Database connection (ASP.NET Core configuration)
# Used when running the API outside Docker; docker-compose sets this automatically.
# -----------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=airagservice;Username=postgres;Password=postgres

# -----------------------------------------------------------------------------
# Embedding provider
# Provider: Local (deterministic hash-based, no API key) | OpenAI
# -----------------------------------------------------------------------------
Embedding__Provider=Local
Embedding__Model=text-embedding-3-small
Embedding__ApiKey=
Embedding__BatchSize=64
Embedding__Dimensions=1536
Embedding__BaseUrl=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# LLM (optional — without ApiKey, queries return retrieved excerpts only)
# -----------------------------------------------------------------------------
Llm__Provider=OpenAI
Llm__Model=gpt-4o-mini
Llm__ApiKey=
Llm__BaseUrl=https://api.openai.com/v1
Llm__Enabled=true

# -----------------------------------------------------------------------------
# RAG retrieval settings
# -----------------------------------------------------------------------------
Rag__ChunkSize=800
Rag__ChunkOverlap=120
Rag__TopK=5

# -----------------------------------------------------------------------------
# API key authentication (optional)
# When enabled, send X-API-Key header on protected endpoints.
# Health, Swagger, and static UI paths remain public.
# -----------------------------------------------------------------------------
ApiKeyAuth__Enabled=false
ApiKeyAuth__ApiKey=
