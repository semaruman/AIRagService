{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Rag": {
    "ChunkSize": 800,
    "ChunkOverlap": 120,
    "TopK": 5
  },
  "Embedding": {
    "Provider": "Local",
    "Model": "text-embedding-3-small",
    "ApiKey": "",
    "BatchSize": 64,
    "Dimensions": 1536,
    "BaseUrl": "https://api.openai.com/v1"
  },
  "Llm": {
    "Provider": "OpenAI",
    "Model": "gpt-4o-mini",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Enabled": true
  },
  "Upload": {
    "MaxFileSizeBytes": 20971520,
    "MaxChunksPerDocument": 5000,
    "MaxQuestionLength": 2000,
    "MaxTopK": 20
  },
  "ApiKeyAuth": {
    "Enabled": false,
    "ApiKey": ""
  }
}
